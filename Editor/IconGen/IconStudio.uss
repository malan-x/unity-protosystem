/* Студия иконок — стили. Тёмная палитра в духе редактора. */

.left-panel {
    width: 300px;
    min-width: 240px;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.5);
    padding: 6px;
}

.left-panel .unity-label {
    white-space: normal;
}

.panel-header {
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 4px;
}

.panel-section {
    margin-top: 8px;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
}

.profile-desc {
    font-size: 10px;
    color: rgba(210, 210, 210, 0.7);
    margin: 2px 4px 4px 4px;
    white-space: normal;
}

.hint {
    font-size: 10px;
    color: rgba(210, 210, 210, 0.55);
    margin: 2px 4px;
    white-space: normal;
}

.ref-row {
    flex-direction: row;
    align-items: center;
}

.ref-row > .unity-object-field {
    flex-grow: 1;
}

.grid-scroll {
    flex-grow: 1;
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px;
}

.section-header {
    -unity-font-style: bold;
    font-size: 12px;
    margin: 8px 8px 0 8px;
    color: rgb(201, 168, 110);
}

.tile {
    margin: 4px;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    border-width: 2px;
    border-color: transparent;
    align-items: center;
}

.tile:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.tile--selected {
    border-color: rgb(201, 168, 110);
}

.tile__image {
    background-color: rgb(30, 30, 30);
    border-radius: 3px;
}

.tile__topbar {
    flex-direction: row;
    justify-content: space-between;
    align-self: stretch;
}

.tile__badge {
    font-size: 9px;
    color: rgba(210, 210, 210, 0.6);
}

.tile__gen {
    font-size: 9px;
    padding: 0 4px;
    margin: 0;
}

.tile__name {
    font-size: 10px;
    margin-top: 2px;
    max-width: 140px;
    overflow: hidden;
}

.picker {
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.5);
    padding: 6px;
    background-color: rgba(0, 0, 0, 0.12);
}

.picker__title {
    -unity-font-style: bold;
    font-size: 12px;
}

.picker__row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.variants-lane {
    flex-direction: row;
    margin-top: 4px;
    height: 116px;
}

.variant-cell {
    width: 96px;
    height: 96px;
    margin-right: 6px;
    background-color: rgb(30, 30, 30);
    border-width: 2px;
    border-color: transparent;
    border-radius: 3px;
    flex-shrink: 0;
}

.variant-cell:hover {
    border-color: rgba(201, 168, 110, 0.4);
}

.variant-cell--active {
    border-color: rgb(217, 166, 64);
}

/* Множественное выделение (Ctrl/Shift) — синее, чтобы не путать с активным (янтарным) */
.variant-cell--picked {
    border-color: rgb(68, 120, 200);
    background-color: rgba(68, 120, 200, 0.12);
}

.variant-cell--bad {
    opacity: 0.4;
    border-color: rgb(204, 64, 51);
}

.variant-cell__deleted {
    color: rgba(210, 210, 210, 0.4);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.prompt-field {
    margin-top: 4px;
}

.prompt-field .unity-text-field__input {
    white-space: normal;
    min-height: 36px;
}

.queue-label {
    -unity-text-align: middle-center;
    padding: 0 6px;
    color: rgb(201, 168, 110);
}
