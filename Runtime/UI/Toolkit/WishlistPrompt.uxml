<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Панель «Добавить в желаемое» (WishlistPromptSystem).

         Имена элементов — контракт с системой, менять нельзя:
         title, body, add-button, already-button, close-button.

         Тексты подставляет система из конфига; строка вида «#ключ» уходит
         в локализацию (ToolkitLocalization), поэтому здесь их нет.

         Стилизация — WishlistPrompt.uss, переменные - -wl-*: проект
         переопределяет их у себя, не трогая пакет. -->

    <Style src="WishlistPrompt.uss" />

    <ui:VisualElement name="wishlist-root" class="wl-root">
        <ui:VisualElement name="wishlist-card" class="wl-card">

            <!-- tooltip не задаём: ключ локализации у каждого проекта свой,
                 а несуществующий показался бы игроку как есть -->
            <ui:Button name="close-button" class="wl-close" text="✕" />

            <ui:Label name="title" class="wl-title" text="" />
            <ui:Label name="body"  class="wl-body"  text="" />

            <ui:VisualElement name="wishlist-buttons" class="wl-buttons">
                <ui:Button name="add-button"     class="wl-btn wl-btn--primary" text="" />
                <ui:Button name="already-button" class="wl-btn wl-btn--ghost"   text="" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
